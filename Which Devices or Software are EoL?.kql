// Devices that have at least one end-of-support (EOL/EOS) title or version

DeviceTvmSoftwareInventory
| where DeviceName != ""
| where isnotempty(EndOfSupportDate) and EndOfSupportDate <= now()
| summarize count() by SoftwareName, DeviceName
