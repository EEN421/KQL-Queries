YourCustomTable_CL
| where TimeGenerated > ago(7d)
| extend FieldCount = array_length(split(RawData, ","))
| summarize
    Events=count(),
    MinFields=min(FieldCount),
    MaxFields=max(FieldCount),
    CommonCounts=make_set(FieldCount, 10)
  by bin(TimeGenerated, 1h), Computer
| order by TimeGenerated desc
